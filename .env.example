# Copy to .env and fill in. Never commit the real .env. Every secret the system
# reads is listed here; the code reads only from the environment (config.py).

# Database-backed web app. Generate separate random 32+ character keys locally.
APP_ENV=development
PERSISTENCE_ENABLED=1
APP_ORIGIN=http://127.0.0.1:8001
ADMIN_API_KEY=
SERVICE_API_KEY=
# Opt-in quota fallback for Groq generation and safety. Uses GEMINI_API_KEY below.
GEMINI_FALLBACK_ENABLED=0
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
BUSINESS_MODE=demo
ANSWER_MODE=extractive
PRICING_REQUIRES_REVIEW=1
BUSINESS_NAME=Demo Office Store
ALLOW_FIXTURE_ORDERS=1
SESSION_DAYS=7
HISTORY_MESSAGES=20
RATE_LIMIT_PER_MINUTE=20
DATABASE_POOL_SIZE=10
# Hosted safety uses the existing Groq key; self-hosting remains optional.
SAFETY_PROVIDER=groq
SAFETY_GROQ_MODEL=openai/gpt-oss-safeguard-20b
# Free development alternative (see README): uncomment these settings, add
# GROQ_API_KEY, and install with pip install -e ".[dev,pii,free]".
# LLM_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# FastEmbed BGE Small is the deployment-compatible knowledge-base embedding.
# Leave SAFETY_MODEL_URL empty for the optional local safety model. Tracing is enabled by default.
# Use a fresh Neon database with CREATE EXTENSION IF NOT EXISTS vector;
# and put its full SSL connection string in DATABASE_URL. No OpenAI key needed.

# --- Reasoning model (Anthropic) ---------------------------------------------
# The agent loop calls Claude over the API, so no GPU runs on our side for it.
ANTHROPIC_API_KEY=replace-with-your-anthropic-api-key

# Model IDs are the exact strings from FACTS.md Section 1. Do not append date
# suffixes to these aliases.
AGENT_MODEL=claude-opus-4-8
ROUTER_MODEL=claude-sonnet-5
CLASSIFIER_MODEL=claude-haiku-4-5

# Depth for the reasoner. One of: low | medium | high | xhigh | max.
AGENT_EFFORT=high

# --- Storage (Postgres + pgvector) -------------------------------------------
# The KB and the tickets share one database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# --- Approved knowledge-base ingestion --------------------------------------
KB_DOCS_PATH=knowledge_base/approved
KB_CHUNK_SIZE=900
KB_CHUNK_OVERLAP=150

# Optional private instructor dataset; leave at the sample path by default.
SUPPORT_HELDOUT_DATASET_PATH=eval/datasets/heldout_tickets.jsonl

# --- Embeddings --------------------------------------------------------------
# "openai" uses text-embedding-3-large (hosted). "bge-m3" uses a local model.
EMBEDDING_PROVIDER=fastembed
OPENAI_API_KEY=replace-with-your-openai-api-key
# Gemini alternative: set EMBEDDING_PROVIDER=gemini,
# EMBEDDING_MODEL=gemini-embedding-001, and EMBEDDING_DIM=384.
# Re-embed ALL existing documents when changing providers, even at the same dimension.
GEMINI_API_KEY=
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# text-embedding-3-large is 3072-dim; truncate with the dimensions arg if you
# want smaller vectors (Matryoshka). Keep this in sync with the DB column.
EMBEDDING_DIM=384

# --- Self-hosted guardrail (Llama Guard 4) -----------------------------------
# The only GPU on our side serves the safety classifier. Point this at your
# OpenAI-compatible model server (vLLM/TGI). Leave unset to run the agent with
# the safety check in "fail-open-and-log" mode for local development.
SAFETY_MODEL_URL=http://localhost:8001/v1
SAFETY_MODEL_NAME=meta-llama/Llama-Guard-4-12B
# Download credentials only: requires access approval on the model's HF page.
# A token alone does not start an inference server. Keep SAFETY_MODEL_URL empty
# until a reachable server is running.
HUGGING_FACE_HUB_TOKEN=

# --- Tracing (OpenTelemetry -> Langfuse or any OTLP backend) ------------------
# Direct Langfuse SDK tracing (no collector required):
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=development
# When all three Langfuse credentials/URL are set, they take precedence over OTLP.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=support-agent
# Set to 0 to disable span export (unit tests, offline eval).
TRACING_ENABLED=1

# --- Ticketing backend --------------------------------------------------------
# The example ticketing tool talks to this base URL. Left empty, ticketing runs
# against the local Postgres table so the repo is runnable without a real desk.
TICKETING_BASE_URL=
TICKETING_API_KEY=

# --- Handoff / confidence -----------------------------------------------------
# The default handoff threshold tau*. eval/threshold.py sweeps this and prints
# the value that holds hallucination under the target; set the chosen value here.
HANDOFF_THRESHOLD=0.60
